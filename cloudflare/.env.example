# Cloudflare API — salin ke .env: cp .env.example .env
# Buat token di: https://dash.cloudflare.com/profile/api-tokens
# Permission minimum: Zone > DNS > Edit (scope: zone Anda)

CF_API_TOKEN=your_cloudflare_api_token_here

# Root domain (zone) — opsional, bisa diisi saat script dijalankan
CF_ZONE_NAME=example.com

# Zone ID — opsional, otomatis dicari dari CF_ZONE_NAME jika kosong
CF_ZONE_ID=

# Default untuk record A (kosong = deteksi IP publik server)
CF_DEFAULT_IP=

# true = proxied (orange cloud), false = DNS only (grey cloud)
CF_DEFAULT_PROXIED=true

# TTL: 1 = auto (wajib jika proxied=true)
CF_DEFAULT_TTL=1
